class Solution:
    def minAbsDiff(self, grid, k):
        m, n = len(grid), len(grid[0])
        ans = []

        for i in range(m - k + 1):
            row = []
            for j in range(n - k + 1):

                values = []

                # collect elements
                for x in range(i, i + k):
                    for y in range(j, j + k):
                        values.append(grid[x][y])

                # remove duplicates
                values = sorted(set(values))

                # if only one unique value
                if len(values) == 1:
                    row.append(0)
                    continue

                # find minimum difference
                min_diff = float('inf')
                for p in range(1, len(values)):
                    min_diff = min(min_diff, values[p] - values[p - 1])

                row.append(min_diff)

            ans.append(row)

        return ans
